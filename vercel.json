{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --onnxruntime-node-install=skip --onnxruntime-node-install-cuda=skip --ignore-scripts && node node_modules/esbuild/install.js || true",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist-demo",
  "rewrites": [
    {
      "source": "/",
      "destination": "/demo.html"
    }
  ]
}
