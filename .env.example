# WickSight — server configuration
# Copy to .env and fill in. .env is gitignored; never commit keys.

# Which adapter to use: auto | binance | okx | mock
# auto = binance if Binance keys exist, else okx if OKX keys exist, else mock
EXCHANGE=auto

# Position to guard (Binance-style symbol)
SYMBOL=BTCUSDT

# --- Binance Futures TESTNET — https://testnet.binancefuture.com ---
# Create keys in the testnet UI: Wallet → API Key. They only work on testnet.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE=https://testnet.binancefuture.com
BINANCE_WS_BASE=wss://stream.binancefuture.com

# --- OKX DEMO (fallback adapter) ---
# Demo trading keys + passphrase from the OKX account settings.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com

# --- Voice ---
# local = Whisper in-process (no API key; model downloads on first run)
# small.en ~250 MB, better with numbers; tiny.en ~40 MB, faster but weaker
# openai = hosted Whisper (needs OPENAI_API_KEY)
ASR_PROVIDER=local
ASR_MODEL=onnx-community/whisper-small.en
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Warm the local ASR model at boot so the first command is not slow
WARM_ASR=1

PORT=8787

# Shared token required by /api/orders/*. The WebView gets the same value at build time.
# Generate one for any public deployment: openssl rand -hex 16
API_TOKEN=change-me-local

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OKX has no separate demo host; this flag must stay on.
OKX_DEMO=1
# Loopback only. Set 0.0.0.0 deliberately if a phone on your LAN must reach it.
HOST=127.0.0.1
