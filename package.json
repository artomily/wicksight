{
  "name": "session-guard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Glanceable position guard for Even G2 \u2014 testnet only",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "sim": "evenhub-simulator http://localhost:5173",
    "sim:auto": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && evenhub pack app.json dist",
    "check": "tsx scripts/check-exchange.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check:live": "tsx scripts/check-exchange.ts --require-live"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@fastify/cors": "^11.0.0",
    "@huggingface/transformers": "^3.7.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8"
  }
}
